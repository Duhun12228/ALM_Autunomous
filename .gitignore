build/
install/
log/
.codex/
.agents/
venv/
__pycache__/
*.pyc

# 로컬 백업 (커밋 X)
_backup_local_*/
# Livox SDK 빌드트리 (UDP 직접파싱으로 전환, 재생성 가능)
ALM_auto_ws/thirdparty/
# 맵은 폴더 하나가 곧 맵 하나다 — maps/<맵이름>/{manifest.yaml, cloud.pcd,
# grid.pgm+grid.yaml, fpfh_map*}. 이 중 대용량 바이너리와 로컬 재생성이 가능한
# 것만 무시하고, manifest.yaml / grid.* / active.yaml 은 계속 추적한다.
#
# 3D 점군맵 + FPFH DB 점군 (대용량, 매핑/빌더로 각 환경에서 재생성)
ALM_auto_ws/src/alm_navigation/maps/*/*.pcd
# FPFH DB 메타 (부모 pcd 지문을 담고 있어 환경마다 달라진다)
ALM_auto_ws/src/alm_navigation/maps/*/fpfh_map.meta
# map_manager 의 지문 캐시
ALM_auto_ws/src/alm_navigation/maps/*/.fingerprint
# 맵 폴더의 .npz 두 종류를 모두 제외한다.
#   scans.npz  : scan_recorder 산출물. pcd2pgm 레이캐스팅 입력이다.
#                수십~수백 MB 라 커밋하지 않는다.
#   sc_db_*.npz: Scan Context DB. 이 브랜치는 SC 를 안 쓰지만(FPFH+TEASER++ 로
#                교체) 로컬에 남은 것이 실수로 커밋되지 않도록 규칙은 유지한다.
#
# ⚠⚠ 맵 폴더를 다른 장비로 **옮길 때는 scans.npz 를 반드시 같이 가져가라.**
#    빠뜨리면 받는 쪽에서 pcd2pgm 이 투영 방식으로 떨어지고, 격자의 8할이
#    미관측으로 남아 대부분의 목표에서 계획이 실패한다(실측 cschool 87.9%).
#    cloud.pcd 만으로는 소급 생성이 안 된다 — 재매핑밖에 없다.
#    git 이 안 옮겨 주므로 rsync/scp 로 직접 옮길 것.
ALM_auto_ws/src/alm_navigation/maps/**/*.npz
# 방식 C(SC-LIO-SAM) 매핑 산출물 — 157MB 바이너리, dev/sc-lio-sam 에서 재생성
ALM_auto_ws/src/alm_navigation/maps/sc_lio_sam_mid360_test/
# 점군 뷰어(CloudCompare/pcl_viewer)가 남기는 카메라 위치 파일
*.cam

# 로컬 측위 실행 로그/빌드 보조 파일
ALM_auto_ws/*.log
ALM_auto_ws/logs/
ALM_auto_ws/symlink_install_manifest.txt

# TEASER++ 런타임 빌드에 사용하지 않는 upstream 자료
ALM_auto_ws/src/thirdparty/TEASER-plusplus/.github/
ALM_auto_ws/src/thirdparty/TEASER-plusplus/doc/
ALM_auto_ws/src/thirdparty/TEASER-plusplus/examples/
ALM_auto_ws/src/thirdparty/TEASER-plusplus/matlab/
ALM_auto_ws/src/thirdparty/TEASER-plusplus/python/
ALM_auto_ws/src/thirdparty/TEASER-plusplus/test/
ALM_auto_ws/src/thirdparty/TEASER-plusplus/.clang-format
ALM_auto_ws/src/thirdparty/TEASER-plusplus/.readthedocs.yml
ALM_auto_ws/src/thirdparty/TEASER-plusplus/README.md
ALM_auto_ws/src/thirdparty/TEASER-plusplus/THANKS.md
