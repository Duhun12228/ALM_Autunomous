build/
install/
log/
.codex/
.agents/
venv/
__pycache__/
*.pyc

# 로컬 백업 (커밋 X)
_backup_local_*/
# Livox SDK 빌드트리 (UDP 직접파싱으로 전환, 재생성 가능)
ALM_auto_ws/thirdparty/
# 3D 점군맵 (대용량 바이너리, 실주행맵 확보 후 별도관리)
ALM_auto_ws/src/alm_navigation/maps/*.pcd
# FPFH 초기측위 DB는 실제 맵에서 로컬로 재생성
ALM_auto_ws/src/alm_navigation/maps/fpfh_map.meta
# Scan Context DB (맵에서 sc_build_db.py 로 재생성 가능)
ALM_auto_ws/src/alm_navigation/maps/*.npz
# 방식 C(SC-LIO-SAM) 매핑 산출물 — 157MB 바이너리, dev/sc-lio-sam 에서 재생성
ALM_auto_ws/src/alm_navigation/maps/sc_lio_sam_mid360_test/
# 점군 뷰어(CloudCompare/pcl_viewer)가 남기는 카메라 위치 파일
*.cam

# 로컬 측위 실행 로그/빌드 보조 파일
ALM_auto_ws/*.log
ALM_auto_ws/logs/
ALM_auto_ws/symlink_install_manifest.txt

# TEASER++ 런타임 빌드에 사용하지 않는 upstream 자료
