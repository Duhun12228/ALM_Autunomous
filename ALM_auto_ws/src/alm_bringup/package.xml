<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>alm_bringup</name>
  <version>0.0.0</version>
  <description>Launch and runtime configuration entry points for the ALM autonomous robot.</description>
  <maintainer email="kdh1228@inha.edu">duhun</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>alm_description</exec_depend>
  <exec_depend>alm_sensors</exec_depend>
  <exec_depend>alm_navigation</exec_depend>
  <exec_depend>alm_base_control</exec_depend>
  <exec_depend>alm_mcu_interface</exec_depend>
  <exec_depend>alm_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- voice_announcer 가 /emergency_stop (Bool) 을 직접 구독한다 -->
  <exec_depend>std_msgs</exec_depend>
  <!-- WebUI 읽기: 텔레메트리 브리지 / 쓰기: 명령 백엔드 -->
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>alm_web_backend</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
