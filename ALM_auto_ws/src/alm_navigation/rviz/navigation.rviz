# 자율주행 관측용 RViz 설정.
#   localization.rviz 는 측위 확인용이라 경로/코스트맵이 없습니다. 이건 주행 중에
#   "왜 저리로 가는가" 를 눈으로 보기 위한 것입니다.
#
# 켜고 끄는 요령
#   · Global Costmap 과 Map 을 동시에 켜면 겹쳐서 헷갈립니다. 보통 Costmap 만 봅니다.
#   · Local Costmap 은 MPPI 가 실제로 보는 것입니다. 벽이 안 보이면 /scan 을 의심하세요
#     (local_costmap 에는 static_layer 가 없고 obstacle_layer 만 있습니다).
#   · MPPI 후보 궤적(/trajectories)은 nav2.yaml 의 FollowPath.visualize: true 라야 나옵니다.
#     기본은 false 입니다 — CPU 를 씁니다.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 60
      Color: 80; 80; 80
      Reference Frame: <Fixed Frame>

    # ---- 맵 / 코스트맵 --------------------------------------------------
    - Class: rviz_default_plugins/Map
      Name: Map (static)
      Enabled: false            # 보통 Global Costmap 만 본다
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 1

    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.6

    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.75

    # ★ Hybrid-A* 가 **실제로 탐색하는** 격자. nav2.yaml 의
    #   GridBased.downsample_costmap: true 라서 global costmap 보다 성깁니다.
    #   "왜 여기로 못 가지?" 를 볼 때 global costmap 이 아니라 이걸 봐야 합니다.
    - Class: rviz_default_plugins/Map
      Name: Downsampled Costmap (플래너가 보는 것)
      Enabled: false
      Topic:
        Value: /downsampled_costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.6

    # ---- 경로 ------------------------------------------------------------
    # /plan 은 planner_server 가 내는 **평활화 전** 경로,
    # /plan_smoothed 는 smoother_server 결과, MPPI 가 따라가는 것은 후자입니다.
    - Class: rviz_default_plugins/Path
      Name: Global Plan (/plan)
      Enabled: true
      Topic:
        Value: /plan
        Depth: 1
        Reliability Policy: Reliable
      Color: 0; 200; 255
      Line Style: Lines
      Pose Style: Axes         # 각 pose 의 yaw 를 본다 — ALIGN 이 보는 값이다
      Pose Axes Length: 0.12
      Pose Axes Radius: 0.015

    - Class: rviz_default_plugins/Path
      Name: Smoothed Plan
      Enabled: true
      Topic:
        Value: /plan_smoothed
        Depth: 1
        Reliability Policy: Reliable
      Color: 255; 220; 0
      Line Style: Lines

    # MPPI 가 실제로 물고 있는 경로 조각. DWB 의 /local_plan 에 해당하는 것이
    # MPPI 에는 없습니다 — 대신 이걸 봅니다 (prune_distance 2.0 m 만큼).
    - Class: rviz_default_plugins/Path
      Name: MPPI 추종 구간
      Enabled: true
      Topic:
        Value: /transformed_global_plan
        Depth: 1
        Reliability Policy: Reliable
      Color: 255; 60; 200
      Line Style: Lines

    # ---- 로봇 / 센서 ------------------------------------------------------
    - Class: rviz_default_plugins/Polygon
      Name: Footprint (local)
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 1
        Reliability Policy: Reliable
      Color: 0; 255; 120
      Alpha: 1

    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan (/scan)
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Reliability Policy: Best Effort
      Size (m): 0.04
      Style: Points
      Color: 255; 90; 90
      Color Transformer: FlatColor
      Decay Time: 0

    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: false
      Topic:
        Value: /Odometry
        Depth: 1
        Reliability Policy: Best Effort
      Keep: 1
      Shape:
        Shaft Length: 0.5
        Head Length: 0.2
        Color: 255; 255; 0

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Marker Scale: 0.5

    # MPPI 후보 궤적. nav2.yaml FollowPath.visualize: true 일 때만 발행됩니다.
    - Class: rviz_default_plugins/MarkerArray
      Name: MPPI Trajectories
      Enabled: false
      Topic:
        Value: /trajectories
        Depth: 1
        Reliability Policy: Reliable

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
      Line color: 128; 128; 0
    # 2D Pose Estimate — FPFH/TEASER++ 자동 초기화가 실패했을 때 손으로 준다
    - Class: rviz_default_plugins/SetInitialPose
      Name: 2D Pose Estimate
      Topic:
        Value: /initialpose
    # 2D Goal Pose — 자율주행 목표. ★ 화살표 방향이 '도착 자세' 다
    - Class: rviz_default_plugins/SetGoal
      Name: 2D Goal Pose
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point

  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Target Frame: base_link
      Scale: 28
      Angle: 0
      X: 0
      Y: 0
    Saved: ~

Window Geometry:
  Displays:
    collapsed: false
  Navigation 2:
    collapsed: false
  Height: 1000
  Width: 1600
