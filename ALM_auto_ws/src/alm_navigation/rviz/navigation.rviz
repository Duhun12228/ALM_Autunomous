Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Localization1
    Splitter Ratio: 0.5
  Splitter Ratio: 0.55
- Class: nav2_rviz_plugins/Navigation 2
  Name: Navigation 2
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Cell Size: 1
    Plane Cell Count: 20
    Color: 160; 160; 164
    Line Style:
      Value: Lines
    Value: true
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Topic:
      Value: /map
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Color Scheme: map
    Draw Behind: true
    Value: true
  - Class: rviz_default_plugins/Odometry
    Name: Odometry
    Enabled: true
    Topic:
      Value: /Odometry
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Keep: 300
    Position Tolerance: 0.1
    Angle Tolerance: 0.1
    Covariance:
      Value: false
    Shape:
      Value: Arrow
      Color: 255; 25; 0
      Alpha: 1
      Head Length: 0.15
      Head Radius: 0.1
      Shaft Length: 0.4
      Shaft Radius: 0.05
    Value: true
  - Class: rviz_default_plugins/PointCloud2
    Name: LiveScan
    Enabled: false
    Topic:
      Value: /cloud_registered
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
    Style: Points
    Size (Pixels): 2
    Color Transformer: FlatColor
    Color: 0; 255; 0
    Decay Time: 0
    Value: true
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: false
    Value: false
  - Class: rviz_default_plugins/Map
    Name: GlobalCostmap
    Enabled: true
    Topic:
      Value: /global_costmap/costmap
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Alpha: 0.35
    Color Scheme: costmap
    Draw Behind: false
    Update Topic:
      Value: /global_costmap/costmap_updates
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Use Timestamp: false
    Value: true
  - Class: rviz_default_plugins/Map
    Name: LocalCostmap
    Enabled: true
    Topic:
      Value: /local_costmap/costmap
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Alpha: 0.6
    Color Scheme: costmap
    Draw Behind: false
    Update Topic:
      Value: /local_costmap/costmap_updates
      Depth: 10
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Use Timestamp: false
    Value: true
  - Class: rviz_default_plugins/Path
    Name: GlobalPlan
    Enabled: true
    Topic:
      Value: /plan
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Color: 111; 190; 255
    Alpha: 1
    Line Style: Lines
    Line Width: 4
    Buffer Length: 1
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Style: None
    Head Diameter: 0.3
    Head Length: 0.2
    Length: 0.3
    Radius: 0.03
    Shaft Diameter: 0.1
    Shaft Length: 0.1
    Value: true
  - Class: rviz_default_plugins/Path
    Name: LocalPlan
    Enabled: true
    Topic:
      Value: /local_plan
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Color: 74; 222; 155
    Alpha: 1
    Line Style: Lines
    Line Width: 3
    Buffer Length: 1
    Offset:
      X: 0
      Y: 0
      Z: 0
    Pose Style: None
    Head Diameter: 0.3
    Head Length: 0.2
    Length: 0.3
    Radius: 0.03
    Shaft Diameter: 0.1
    Shaft Length: 0.1
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Waypoints
    Enabled: true
    Topic:
      Value: /waypoints
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Namespaces: {}
    Value: true
  - Class: rviz_default_plugins/PointCloud2
    Name: AlignedScan
    Enabled: false
    Topic:
      Value: /teaser_aligned_cloud
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
      Filter size: 10
    Alpha: 1
    Autocompute Intensity Bounds: true
    Axis: Z
    Channel Name: intensity
    Color: 255; 170; 0
    Color Transformer: FlatColor
    Decay Time: 0
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 3
    Size (m): 0.05
    Style: Points
    Use Fixed Frame: true
    Use rainbow: false
    Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/SetInitialPose
    Topic:
      Value: /initialpose
      Depth: 5
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Reliable
    Covariance x: 0.25
    Covariance y: 0.25
    Covariance yaw: 0.06853891909122467
  - Class: nav2_rviz_plugins/GoalTool
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDown
      Angle: 0
      Scale: 25
      Target Frame: map
      X: 0
      Y: -1.5
      Invert Z Axis: false
    Saved: null
Window Geometry:
  Height: 1000
  Width: 1600
  Hide Left Dock: false
  Hide Right Dock: false
  Displays:
    collapsed: false
  Navigation 2:
    collapsed: false
  Views:
    collapsed: true
  Tool Properties:
    collapsed: false
  QMainWindow State: ''
