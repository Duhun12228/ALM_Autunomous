<!--
  ALM NavigateToPose BT
  = nav2 기본 navigate_to_pose_w_replanning_and_recovery.xml
    + ComputePathToPose 뒤에 SmoothPath(ConstrainedSmoother) 삽입.

  ComputePathToPose(SmacPlannerHybrid) -> {path}
    -> SmoothPath(ConstrainedSmoother) -> 같은 {path} 로 덮어쓰기
    -> FollowPath(MPPI)

  Hybrid-A* 가 이미 R_min=1.643 m 를 지키는 경로를 내므로 스무더는 '구제'가 아니라
  '마감'이다. 모션 프리미티브 이음매와 각도 양자화(5°) 자국을 없애고 장애물에서
  조금 더 떨어뜨린다. 그래서 실패해도 원본 경로로 주행하면 된다 —
  Fallback + AlwaysSuccess 로 감싼 이유다. 실패 시 블랙보드의 {path} 는 갱신되지
  않으므로 평활화 이전 경로가 그대로 FollowPath 로 넘어간다.
  (check_for_collisions=true 이므로 평활화 결과가 장애물을 스치면 실패로 처리됨)

  ##주의## planner_id="GridBased" 는 nav2.yaml 의 planner_server.GridBased,
  smoother_id="SmoothPath" 는 smoother_server.SmoothPath 를 가리킨다.
  이름을 바꾸면 여기도 같이 바꿔야 한다.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <Sequence name="PlanAndSmooth">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
              <Fallback name="SmoothIfPossible">
                <SmoothPath unsmoothed_path="{path}" smoothed_path="{path}"
                            smoother_id="SmoothPath"
                            max_smoothing_duration="0.5"
                            check_for_collisions="true"/>
                <AlwaysSuccess/>
              </Fallback>
            </Sequence>
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <!-- Spin/BackUp 은 command_manager 의 auto 모드가 각각 spin(제자리회전)과
               normal 후진으로 실행한다. backup_speed 는 min_linear_x(-0.15) 이내. -->
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
